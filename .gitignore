# ==============================================================================
# .gitignore para Proyecto Python (Hundir la Flota)
# ==============================================================================

# --- Archivos compilados y caché de Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Entornos virtuales ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Jupyter Notebooks (Checkpoints temporales) ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Pruebas y Cobertura (Unit tests & Pytest) ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# --- Distribución y Construcción ---
build/
dist/
*.egg-info/
*.egg

# --- IDEs y Editores de Código ---
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# PyCharm / IntelliJ
.idea/
*.iws

# Archivos temporales de editores
*.swp
*.swo
*~

# --- Archivos del Sistema Operativo ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
